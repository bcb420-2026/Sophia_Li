@article{chen_robust_2020,
	title = {Robust principal component analysis for accurate outlier sample detection in {RNA}-{Seq} data},
	volume = {21},
	issn = {1471-2105},
	url = {https://doi.org/10.1186/s12859-020-03608-0},
	doi = {10.1186/s12859-020-03608-0},
	abstract = {High throughput RNA sequencing is a powerful approach to study gene expression. Due to the complex multiple-steps protocols in data acquisition, extreme deviation of a sample from samples of the same treatment group may occur due to technical variation or true biological differences. The high-dimensionality of the data with few biological replicates make it challenging to accurately detect those samples, and this issue is not well studied in the literature currently. Robust statistics is a family of theories and techniques aim to detect the outliers by first fitting the majority of the data and then flagging data points that deviate from it. Robust statistics have been widely used in multivariate data analysis for outlier detection in chemometrics and engineering. Here we apply robust statistics on RNA-seq data analysis.},
	language = {en},
	number = {1},
